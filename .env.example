# Shopify Store API Access — either fill these in directly (Custom App token)...
SHOPIFY_STORE_URL="your-shop-name.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ...or set these instead and use the "Connect with Shopify" OAuth flow at /settings
# (from a Shopify Partners app; SHOPIFY_APP_URL must match this server's public URL,
# and <SHOPIFY_APP_URL>/auth/shopify/callback must be whitelisted in that app's config)
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_APP_URL=""
SHOPIFY_SCOPES="read_products"

# Google AI Studio Credentials
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# File System Configurations
OUTPUT_DIR="./generated_videos"
